{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polymath-quest-api",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polymath-quest-d1",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "polymath-quest-kv"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "MASTER_ENCRYPTION_KEY": "polymath-quest-master-edge-secret-2026"
  }
}
